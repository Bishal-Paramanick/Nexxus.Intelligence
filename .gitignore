Set-Content -Path ".gitignore" -Value @"
# Environment & Secrets
.env
.env.local
*.env

# Role-specific local exclusions
backend/app/database/neo4j_driver.py
frontend/*
!frontend/.gitkeep
cypher/*
!cypher/.gitkeep

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/

# Node & Frontend
node_modules/
dist/
build/
.npm

# IDEs & System
.vscode/
.idea/
.DS_Store
Thumbs.db
"@